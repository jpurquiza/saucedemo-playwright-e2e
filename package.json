{
  "name": "saucedemo-playwright-e2e",
  "version": "1.0.0",
  "description": "E2E test automation framework for SauceDemo using Playwright and TypeScript",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:login": "playwright test tests/login.spec.ts",
    "test:cart": "playwright test tests/cart.spec.ts",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed --workers=1",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "test-automation",
    "saucedemo"
  ],
  "author": "Juan Pablo Urquiza",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "dotenv": "^18.0.1",
    "typescript": "^7.0.2"
  }
}
