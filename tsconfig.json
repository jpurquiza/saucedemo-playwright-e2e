{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "types": ["node", "@playwright/test"],
    "strict": true,
    "esModuleInterop": true
  },
  "include": [
    "playwright.config.ts",
    "config/**/*.ts",
    "pages/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "playwright-report", "test-results"]
}
